# scripting addition
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# default layout
yabai -m config layout bsp

# new window spawns to the right if vertical split,
# or bottom if horizontal split
yabai -m config window_placement second_child

# padding / gaps
yabai -m config top_padding 0
yabai -m config bottom_padding 0
yabai -m config left_padding 0
yabai -m config right_padding 0
yabai -m config window_gap 2

# center mouse on window with focus
yabai -m config mouse_follows_focus on

# focus window when mouse enters it
yabai -m config focus_follows_mouse autofocus

# modifier for clicking and dragging with mouse
yabai -m config mouse_modifier alt

# alt + left-click = move
yabai -m config mouse_action1 move

# alt + right-click = resize
yabai -m config mouse_action2 resize

# dropping a window in the center of another swaps them
yabai -m config mouse_drop_action swap


# floating / unmanaged applications
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Mail$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^Qbserve$" manage=off
yabai -m rule --add app="^Google Drive$" manage=off
yabai -m rule --add app="^Synology Drive Client$" manage=off
yabai -m rule --add app="^ColorSlurp$" manage=off

# also apply rules to windows that already existed when yabai restarted
yabai -m rule --apply
